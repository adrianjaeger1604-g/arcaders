[node name="Instruction" type="Label" parent="IntroContainer/VBox/ScrollArea/InstructionContainer"]
layout_mode = 2
size_flags_horizontal = 3
theme_type_variation = &"H3"
theme_override_constants/line_spacing = 8
text = "1. Die Merkphase (60 Sekunden):
19 Hexagon-Felder zeigen Zufallszahlen von 1 bis 5. Prägt euch die Positionen und Werte gut ein!

2. Die Quizphase & Zielsumme:
Nach Ablauf der Merkzeit werden die Zahlen durch Buchstaben (A bis S) verdeckt. Eine Zielsumme wird aufgedeckt.

3. Drei Felder in gerader Linie:
Drei zusammenhängende Felder in einer geraden Linie (waagerecht oder diagonal) müssen addiert die Zielsumme ergeben.

4. Buzzer auf dem Smartphone:
Wer eine gültige Dreier-Reihe weiß, buzzert auf dem Handy und nennt dem Game Master die 3 Buchstaben (z. B. A-D-H)!

5. Punkte & Spielziel:
• Richtig: +1 Punkt für das Team!
• Falsch: -1 Punkt Abzug (Minuspunkte sind möglich!).
• Wenn 30 Sekunden lang niemand buzzert, werden alle restlichen Kombinationen direkt auf dem Hexagon aufgedeckt.
• Das Team mit den meisten Punkten nach 3 Runden gewinnt das Minispiel!"
horizontal_alignment = 1
autowrap_mode = 2

