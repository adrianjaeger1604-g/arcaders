[node name="Instruction" type="Label" parent="IntroContainer/VBox/ScrollArea/InstructionContainer"]
layout_mode = 2
size_flags_horizontal = 3
theme_type_variation = &"H3"
theme_override_constants/line_spacing = 8
text = "1. Das Thema der Runde:
Pro Runde wird ein zufälliges Thema vorgegeben (z. B. „Länder in Afrika“).

2. Geheime Wettrunde auf dem Smartphone:
Alle Spieler schätzen geheim ein, wie viele Begriffe der eigene Teampartner aufzählen kann.
Wichtig: Während der Wettphase darf im Team NICHT gesprochen oder sich abgesprochen werden!

3. Wetten aufdecken & Höchstbietender:
Der Game Master deckt alle Gebote auf. Die Person mit dem höchsten Gebot muss antreten und aufzählen!
Gibt es einen Gleichstand beim Höchstgebot, entscheidet das Los direkt im Spiel!

4. Die Aufzählung – 10 Sekunden pro Begriff:
Beim Aufzählen läuft unerbittlich ein 10-Sekunden-Timer!
Wird innerhalb von 10 Sekunden kein neuer gültiger Begriff genannt, ist die Runde verloren.
Jeder richtige Begriff zählt den Zähler um -1 herunter und setzt den Timer wieder auf 10 Sekunden zurück.

5. Punkte & Spielziel:
• Geschafft: Wird der Zähler auf 0 heruntergezählt, erhält das Team +1 Punkt!
• Aufgeben oder Zeit abgelaufen: Das Team erhält -1 Punkt (Minuspunkte sind möglich!).
• Welches Team zuerst 3 In-Game-Punkte erreicht, gewinnt das Minispiel!"
horizontal_alignment = 1
autowrap_mode = 2

