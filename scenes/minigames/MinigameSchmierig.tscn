[node name="Instruction" type="Label" parent="IntroContainer/VBox/ScrollArea/InstructionContainer"]
layout_mode = 2
size_flags_horizontal = 3
theme_type_variation = &"H3"
theme_override_constants/line_spacing = 8
text = "1. Das Spielprinzip:
Ein stark verschwommenes Bild wird Sekunde für Sekunde schärfer. Erkennt so schnell wie möglich, was auf dem Bild zu sehen ist!

2. Der Buzzer:
Sobald du glaubst, das Motiv zu erkennen, drücke sofort den Buzzer auf deinem Smartphone.

3. Sichtschutz beim Überlegen:
Sobald gebuzzert wurde, wird das Bild sofort wieder unscharf maskiert, damit niemand beim Überlegen weiterschauen kann. Nenne deine Antwort laut dem Spielleiter!

4. Ein Versuch pro Team:
Antwortet das Team richtig, erhält es einen Punkt. Antwortet das Team falsch, wird der Buzzer des gesamten Teams für dieses Bild gesperrt. Die anderen Teams dürfen weiterraten.

5. Spielziel:
Das erste Team, das 3 Punkte erreicht, gewinnt das Minispiel!"
horizontal_alignment = 1
autowrap_mode = 2

