[node name="Instruction" type="Label" parent="IntroContainer/VBox/ScrollArea/InstructionContainer"]
layout_mode = 2
size_flags_horizontal = 3
theme_type_variation = &"H3"
theme_override_constants/line_spacing = 8
text = "1. Ausrüstungsphase:
Wählt geheim auf eurem Handy euren Kampftyp (Schere, Stein oder Papier) und eure Klasse (Tank, Damage Dealer oder Utility). Danach wird die Auswahl aller Spieler aufgedeckt.

2. Planungsphase:
In jeder Runde plant ihr auf dem Handy euren Laufweg über das Schlachtfeld sowie eure Schlagrichtung. Sonderfelder bringen euch Heilung, Bonusschaden, Teleportation, Typwechsel oder einen Meteorschlag.

3. Schlacht und Feuerzone:
Alle Bewegungen und Angriffe werden gleichzeitig aufgelöst. Alle zwei Runden breitet sich das Feuer vom Rand weiter nach innen aus. Das letzte überlebende Team gewinnt!"
horizontal_alignment = 1
autowrap_mode = 2

