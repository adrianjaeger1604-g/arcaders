[node name="Instruction" type="Label" parent="IntroContainer/VBox/ScrollArea/InstructionContainer"]
layout_mode = 2
size_flags_horizontal = 3
theme_type_variation = &"H3"
theme_override_constants/line_spacing = 8
text = "1. Alle gegen Alle auf eisigen Höhen:
Alle Spieler treten gleichzeitig mit ihrem Charakter an und klettern um die Wette!

2. Steuerung in Echtzeit über dein Handy:
Steuere deinen Charakter live mit dem Joystick nach links und rechts und katapultiere dich mit dem Sprung-Button über die Plattformen.

3. Erst Testen, dann Klettern:
Im Testraum könnt ihr euch warmspringen und Eisblöcke von unten zerschlagen. Klickt unten auf den Button \"SPIEL STARTEN\", um das echte Rennen zu beginnen!

4. Endlos nach oben: Wer fällt, scheidet aus!
Im echten Spiel zieht die Kamera nach oben nach. Wer unten aus dem Bildschirmrand fällt, scheidet sofort aus!

5. Letztes überlebendes Team gewinnt:
Kämpft euch plattformweise nach oben. Das letzte noch stehende Team gewinnt!"
horizontal_alignment = 1
autowrap_mode = 2

